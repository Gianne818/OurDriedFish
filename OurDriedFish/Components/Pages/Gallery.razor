@page "/gallery"
@inject IDriedFishRepository FishRepository

<PageTitle>Gallery | Our Dried Fish®</PageTitle>

<div class="pt-10 pb-8">
    <div class="site-container">
        <!-- Main Page Title matching Desktop.png, Tablet.png, Mobile.png -->
        <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
            <h1 class="page-title !mb-0">GALLERY</h1>
            <button type="button"
                    class="btn-pill"
                    @onclick="OpenAddForm">
                @(showForm && editingId is null ? "CLOSE FORM" : "ADD PRODUCT")
            </button>
        </div>

        <!-- Database Filter Bar (Habit 2: filters in PostgreSQL before Get) -->
        <div class="flex flex-col sm:flex-row gap-3 mb-8">
            <input type="text"
                   @bind="searchQuery"
                   @bind:event="oninput"
                   @onkeydown="HandleSearchKeyDown"
                   placeholder="Search dried fish by name..."
                   class="flex-1 px-4 py-2.5 rounded-lg border border-neutral-300 bg-neutral-50 text-sm text-[#111111] outline-none focus:border-[#111111] focus:bg-white" />

            <select @bind="selectedCategory"
                    @bind:after="ApplyFilterAsync"
                    class="sm:w-56 px-4 py-2.5 rounded-lg border border-neutral-300 bg-neutral-50 text-sm text-[#111111] outline-none cursor-pointer focus:border-[#111111] focus:bg-white">
                @foreach (var cat in Categories)
                {
                    <option value="@cat">@cat</option>
                }
            </select>

            <button type="button"
                    class="btn-dark-pill !rounded-lg !px-5"
                    disabled="@isLoading"
                    @onclick="ApplyFilterAsync">
                SEARCH
            </button>

            @if (!string.IsNullOrWhiteSpace(searchQuery) || selectedCategory != "All")
            {
                <button type="button"
                        class="px-4 py-2.5 text-xs font-heading font-bold uppercase tracking-wider text-neutral-600 border border-neutral-300 rounded-lg hover:border-[#111111] hover:text-[#111111]"
                        @onclick="ClearFilterAsync">
                    RESET
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mb-6 p-4 rounded-2xl border border-red-200 bg-red-50 text-sm text-red-800">
                <strong>Database error:</strong> @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="mb-6 p-4 rounded-2xl border border-green-200 bg-green-50 text-sm text-green-800 flex items-center justify-between gap-4">
                <span>@statusMessage</span>
                <button type="button" class="text-xs font-bold uppercase underline" @onclick="() => statusMessage = null">Dismiss</button>
            </div>
        }

        <!-- Create / Update Product Form -->
        @if (showForm)
        {
            <div class="mb-10 bg-white border border-neutral-200 rounded-[26px] p-6 sm:p-8 shadow-[0_4px_20px_rgba(0,0,0,0.06)]">
                <div class="flex items-center justify-between gap-4 mb-6">
                    <div>
                        <span class="inline-block text-[10px] font-extrabold tracking-widest bg-[#111111] text-white px-2.5 py-1 rounded-full mb-2 uppercase">
                            @(editingId.HasValue ? "UPDATE DELICACY" : "NEW DELICACY")
                        </span>
                        <h2 class="font-heading text-2xl font-black tracking-tight text-[#111111]">
                            @(editingId.HasValue ? $"Edit {formModel.Name}" : "Add a Dried Fish Item")
                        </h2>
                    </div>
                    <button type="button"
                            class="text-xs font-bold uppercase tracking-wider text-neutral-500 hover:text-[#111111]"
                            @onclick="CancelForm">
                        Cancel ✕
                    </button>
                </div>

                <EditForm Model="@formModel" OnValidSubmit="SaveProductAsync">
                    <DataAnnotationsValidator />

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-4">
                        <div class="flex flex-col">
                            <label for="prodName" class="text-xs font-black uppercase tracking-wider mb-1.5 text-neutral-800">Product Name</label>
                            <InputText id="prodName" @bind-Value="formModel.Name" class="px-3.5 py-2.5 rounded-md border border-neutral-300 bg-neutral-50 text-sm text-[#111111] focus:border-[#111111] focus:bg-white outline-none" placeholder="e.g. DANGGIT" />
                            <ValidationMessage For="@(() => formModel.Name)" class="text-xs text-red-600 mt-1 font-semibold" />
                        </div>

                        <div class="flex flex-col">
                            <label for="prodLocalName" class="text-xs font-black uppercase tracking-wider mb-1.5 text-neutral-800">Local Name</label>
                            <InputText id="prodLocalName" @bind-Value="formModel.LocalName" class="px-3.5 py-2.5 rounded-md border border-neutral-300 bg-neutral-50 text-sm text-[#111111] focus:border-[#111111] focus:bg-white outline-none" placeholder="e.g. Bulad Danggit" />
                        </div>

                        <div class="flex flex-col">
                            <label for="prodCategory" class="text-xs font-black uppercase tracking-wider mb-1.5 text-neutral-800">Category</label>
                            <InputText id="prodCategory" @bind-Value="formModel.Category" class="px-3.5 py-2.5 rounded-md border border-neutral-300 bg-neutral-50 text-sm text-[#111111] focus:border-[#111111] focus:bg-white outline-none" placeholder="e.g. Rabbitfish & Spinefoot" />
                            <ValidationMessage For="@(() => formModel.Category)" class="text-xs text-red-600 mt-1 font-semibold" />
                        </div>

                        <div class="flex flex-col">
                            <label for="prodPrice" class="text-xs font-black uppercase tracking-wider mb-1.5 text-neutral-800">Price per KG (PHP)</label>
                            <InputNumber id="prodPrice" @bind-Value="formModel.PricePerKg" class="px-3.5 py-2.5 rounded-md border border-neutral-300 bg-neutral-50 text-sm text-[#111111] focus:border-[#111111] focus:bg-white outline-none" />
                            <ValidationMessage For="@(() => formModel.PricePerKg)" class="text-xs text-red-600 mt-1 font-semibold" />
                        </div>

                        <div class="flex flex-col">
                            <label for="prodStock" class="text-xs font-black uppercase tracking-wider mb-1.5 text-neutral-800">Stock Quantity (KG)</label>
                            <InputNumber id="prodStock" @bind-Value="formModel.StockQuantity" class="px-3.5 py-2.5 rounded-md border border-neutral-300 bg-neutral-50 text-sm text-[#111111] focus:border-[#111111] focus:bg-white outline-none" />
                            <ValidationMessage For="@(() => formModel.StockQuantity)" class="text-xs text-red-600 mt-1 font-semibold" />
                        </div>

                        <div class="flex flex-col">
                            <label for="prodOrigin" class="text-xs font-black uppercase tracking-wider mb-1.5 text-neutral-800">Origin</label>
                            <InputText id="prodOrigin" @bind-Value="formModel.Origin" class="px-3.5 py-2.5 rounded-md border border-neutral-300 bg-neutral-50 text-sm text-[#111111] focus:border-[#111111] focus:bg-white outline-none" placeholder="Cebu, Philippines" />
                        </div>

                        <div class="flex flex-col sm:col-span-2">
                            <label for="prodImage" class="text-xs font-black uppercase tracking-wider mb-1.5 text-neutral-800">Product Image</label>
                            <InputSelect id="prodImage" @bind-Value="formModel.ImageUrl" class="px-3.5 py-2.5 rounded-md border border-neutral-300 bg-neutral-50 text-sm text-[#111111] focus:border-[#111111] focus:bg-white outline-none cursor-pointer">
                                @foreach (var img in ImageOptions)
                                {
                                    <option value="@img.Value">@img.Label</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="flex items-end pb-2">
                            <label class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-neutral-800 cursor-pointer">
                                <InputCheckbox @bind-Value="formModel.IsSeasonal" class="w-4 h-4 accent-[#111111]" />
                                <span>Seasonal Delicacy</span>
                            </label>
                        </div>
                    </div>

                    <div class="flex flex-col mb-5">
                        <label for="prodDescription" class="text-xs font-black uppercase tracking-wider mb-1.5 text-neutral-800">Description</label>
                        <InputTextArea id="prodDescription" @bind-Value="formModel.Description" rows="2" class="px-3.5 py-2.5 rounded-md border border-neutral-300 bg-neutral-50 text-sm text-[#111111] focus:border-[#111111] focus:bg-white outline-none" placeholder="Taste, curing method, and serving notes..." />
                    </div>

                    <div class="flex items-center gap-3">
                        <button type="submit"
                                disabled="@isSaving"
                                class="py-3 px-6 bg-[#FFC700] hover:bg-[#E8B400] text-black font-heading text-xs font-black tracking-wider uppercase rounded-full transition disabled:opacity-50">
                            @(isSaving ? "SAVING..." : (editingId.HasValue ? "• SAVE CHANGES" : "• ADD TO CATALOG"))
                        </button>
                        <button type="button"
                                class="py-3 px-5 text-xs font-heading font-bold uppercase tracking-wider text-neutral-600 hover:text-[#111111]"
                                @onclick="CancelForm">
                            Cancel
                        </button>
                    </div>
                </EditForm>
            </div>
        }

        <!-- 2-Column Section: Sidebar Label on Left (Desktop), Products on Right -->
        <div class="grid grid-cols-1 md:grid-cols-[180px_1fr] lg:grid-cols-[200px_1fr] gap-6 md:gap-10 mb-16 lg:mb-20">
            <div class="pt-1.5">
                <span class="section-label">SEASONAL DRIED DELICACIES</span>
                <p class="text-xs text-neutral-500 mt-1">@Products.Count @(Products.Count == 1 ? "item" : "items")</p>
            </div>

            @if (isLoading)
            {
                <div class="py-12 text-center text-sm text-neutral-500">
                    Loading dried delicacies from Supabase...
                </div>
            }
            else if (Products.Count == 0)
            {
                <div class="bg-neutral-50 border border-neutral-200 rounded-[20px] p-10 text-center">
                    <p class="text-sm text-neutral-600 mb-4">No dried fish items match your filter.</p>
                    <button type="button" class="btn-pill" @onclick="ClearFilterAsync">SHOW ALL PRODUCTS</button>
                </div>
            }
            else
            {
                <!-- 3x3 Product Grid matching Desktop.png (3 cols), Tablet.png (2 cols), Mobile.png (1 col) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 lg:gap-x-9 gap-y-8 sm:gap-y-10 lg:gap-y-12">
                    @foreach (var product in Products)
                    {
                        <ProductCard Product="@product"
                                     IsBusy="@isSaving"
                                     OnEdit="StartEdit"
                                     OnDelete="SoftDeleteProductAsync" />
                    }
                </div>
            }
        </div>

        <hr class="border-0 border-t border-neutral-300 my-12 md:my-16" />

        <!-- Services Section matching Desktop.png lower half: Sidebar "SERVICES" on left, Split Items on right -->
        <ServicesSection IsNumberedLayout="false" />

        <!-- Order Now CTA Banner matching Desktop.png -->
        <OrderCtaBanner Label="ORDER NOW"
                        Heading="Discover how we can add a touch of natural dried deliciousness to your next meal."
                        ButtonText="ABOUT US"
                        ButtonLink="/about" />
    </div>
</div>

@code {
    private IReadOnlyList<DriedFishItem> Products { get; set; } = new List<DriedFishItem>();
    private List<string> Categories { get; set; } = new() { "All" };

    private string searchQuery = string.Empty;
    private string selectedCategory = "All";

    private bool isLoading = true;
    private bool isSaving;
    private bool showForm;
    private int? editingId;
    private DriedFishItem formModel = NewBlankProduct();
    private string? errorMessage;
    private string? statusMessage;

    private static readonly (string Label, string Value)[] ImageOptions =
    {
        ("Danggit", "images/products/danggit.png"),
        ("Dried Squid", "images/products/dried-squid.png"),
        ("Fish Tocino", "images/products/fish-tocino.png"),
        ("Dried Anchovies", "images/products/dried-anchovies.png"),
        ("Dried Katambak", "images/products/dried-katambak.png"),
        ("Dried Flounder", "images/products/dried-flounder.png"),
        ("Bisugo", "images/products/bisugo.png"),
        ("Dalagang Bukid", "images/products/dalagang-bukid.png"),
        ("Dried Herring", "images/products/dried-herring.png"),
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync(refreshCategories: true);
    }

    private async Task LoadProductsAsync(bool refreshCategories = false)
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            if (string.IsNullOrWhiteSpace(searchQuery) && selectedCategory == "All")
            {
                Products = await FishRepository.GetAllAsync();
                if (refreshCategories)
                {
                    var cats = Products
                        .Select(p => p.Category)
                        .Where(c => !string.IsNullOrWhiteSpace(c))
                        .Distinct()
                        .OrderBy(c => c)
                        .ToList();
                    cats.Insert(0, "All");
                    Categories = cats;
                }
            }
            else
            {
                Products = await FishRepository.SearchAsync(searchQuery, selectedCategory);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilterAsync()
    {
        await LoadProductsAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilterAsync();
        }
    }

    private async Task ClearFilterAsync()
    {
        searchQuery = string.Empty;
        selectedCategory = "All";
        await LoadProductsAsync(refreshCategories: true);
    }

    private void OpenAddForm()
    {
        if (showForm && editingId is null)
        {
            showForm = false;
            return;
        }

        editingId = null;
        formModel = NewBlankProduct();
        showForm = true;
        statusMessage = null;
        errorMessage = null;
    }

    private void StartEdit(DriedFishItem product)
    {
        editingId = product.Id;
        formModel = new DriedFishItem
        {
            Id = product.Id,
            Name = product.Name,
            LocalName = product.LocalName,
            ScientificName = product.ScientificName,
            Description = product.Description,
            WeightGrams = product.WeightGrams,
            PricePerKg = product.PricePerKg,
            StockQuantity = product.StockQuantity,
            Category = product.Category,
            ImageUrl = product.ImageUrl,
            IsSeasonal = product.IsSeasonal,
            Origin = product.Origin,
            TasteProfile = product.TasteProfile,
            PreparationTips = product.PreparationTips,
            AvailableWeightsGrams = new List<int>(product.AvailableWeightsGrams)
        };
        showForm = true;
        statusMessage = null;
        errorMessage = null;
    }

    private void CancelForm()
    {
        showForm = false;
        editingId = null;
        formModel = NewBlankProduct();
    }

    private async Task SaveProductAsync()
    {
        if (isSaving) return;

        isSaving = true;
        errorMessage = null;
        statusMessage = null;

        try
        {
            if (editingId.HasValue)
            {
                formModel.Id = editingId.Value;
                await FishRepository.UpdateAsync(formModel);
                statusMessage = $"Updated \"{formModel.Name.Trim().ToUpperInvariant()}\" in Supabase.";
            }
            else
            {
                await FishRepository.AddAsync(formModel);
                statusMessage = $"Added \"{formModel.Name.Trim().ToUpperInvariant()}\" to Supabase.";
            }

            showForm = false;
            editingId = null;
            formModel = NewBlankProduct();
            await LoadProductsAsync(refreshCategories: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SoftDeleteProductAsync(DriedFishItem product)
    {
        if (isSaving) return;

        isSaving = true;
        errorMessage = null;
        statusMessage = null;

        try
        {
            await FishRepository.SoftDeleteAsync(product.Id);
            statusMessage = $"Removed \"{product.Name}\" (soft deleted with deleted_at timestamp).";
            await LoadProductsAsync(refreshCategories: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private static DriedFishItem NewBlankProduct() => new()
    {
        PricePerKg = 650m,
        StockQuantity = 25,
        Category = "Whitefish & Snappers",
        Origin = "Cebu, Philippines",
        ImageUrl = "images/products/danggit.png"
    };
}
