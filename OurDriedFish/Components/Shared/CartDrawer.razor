@inject CartService CartService
@implements IDisposable

@if (CartService.IsDrawerOpen)
{
    <div class="cart-backdrop" @onclick="CartService.CloseDrawer">
        <aside class="cart-drawer" @onclick:stopPropagation>
            <div class="drawer-header">
                <div class="drawer-title-group">
                    <h2 class="drawer-title">YOUR CART</h2>
                    <span class="drawer-count">(@CartService.TotalItemCount items)</span>
                </div>
                <button type="button" class="drawer-close-btn" @onclick="CartService.CloseDrawer" aria-label="Close cart">
                    &times;
                </button>
            </div>

            @if (CartService.LastActionMessage != null)
            {
                <div class="notification-pill">
                    <span>@CartService.LastActionMessage</span>
                    <button type="button" class="notification-close" @onclick="CartService.ClearNotification">&times;</button>
                </div>
            }

            <div class="drawer-body">
                @if (CartService.Items.Count == 0)
                {
                    <div class="empty-cart-state">
                        <div class="empty-cart-icon">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#CCCCCC" stroke-width="1.5">
                                <circle cx="9" cy="21" r="1"></circle>
                                <circle cx="20" cy="21" r="1"></circle>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                            </svg>
                        </div>
                        <h3>Your basket is empty</h3>
                        <p>Discover our artisanal sun-dried rabbitfish, anchovies, squid, and native delicacies.</p>
                        <a href="/gallery" class="btn-pill mt-3" @onclick="CartService.CloseDrawer">
                            EXPLORE GALLERY
                        </a>
                    </div>
                }
                else
                {
                    <ul class="cart-items-list">
                        @foreach (var item in CartService.Items)
                        {
                            <li class="cart-item">
                                <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="cart-item-img" />
                                <div class="cart-item-details">
                                    <div class="cart-item-top">
                                        <h4 class="cart-item-name">@item.Product.Name</h4>
                                        <button type="button" class="cart-item-remove" @onclick="() => CartService.RemoveItem(item.Product.Id, item.SelectedWeightGrams)" title="Remove item">
                                            &times;
                                        </button>
                                    </div>
                                    <span class="cart-item-variant">Pack: @(item.SelectedWeightGrams >= 1000 ? $"{item.SelectedWeightGrams / 1000}kg" : $"{item.SelectedWeightGrams}g")</span>
                                    <div class="cart-item-bottom">
                                        <div class="cart-qty-stepper">
                                            <button type="button" class="stepper-btn" @onclick="() => CartService.UpdateQuantity(item.Product.Id, item.SelectedWeightGrams, item.Quantity - 1)">-</button>
                                            <span class="stepper-val">@item.Quantity</span>
                                            <button type="button" class="stepper-btn" @onclick="() => CartService.UpdateQuantity(item.Product.Id, item.SelectedWeightGrams, item.Quantity + 1)">+</button>
                                        </div>
                                        <span class="cart-item-price">PHP @item.TotalPrice.ToString("N0")</span>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>

            @if (CartService.Items.Count > 0)
            {
                <div class="drawer-footer">
                    <div class="summary-line">
                        <span>Subtotal</span>
                        <span class="summary-amount">PHP @CartService.Subtotal.ToString("N0")</span>
                    </div>
                    <div class="summary-line subtle">
                        <span>Shipping Estimate</span>
                        <span>Calculated at checkout</span>
                    </div>
                    <button type="button" class="checkout-btn" @onclick="HandleCheckout">
                        CHECKOUT • PHP @CartService.Subtotal.ToString("N0")
                    </button>
                    @if (IsCheckoutSuccess)
                    {
                        <div class="checkout-success-banner">
                            Thank you! Your dried fish order has been received for processing.
                        </div>
                    }
                </div>
            }
        </aside>
    </div>
}

@code {
    private bool IsCheckoutSuccess { get; set; } = false;

    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }

    private void HandleCheckout()
    {
        IsCheckoutSuccess = true;
        CartService.Clear();
    }
}
