@inject CartService Cart
@implements IDisposable

@if (Cart.IsOpen)
{
    <div class="fixed inset-0 z-[1200] overflow-hidden" aria-labelledby="slide-over-title" role="dialog" aria-modal="true">
        <!-- Background backdrop -->
        <div class="fixed inset-0 bg-black/50 backdrop-blur-[2px] transition-opacity duration-300" 
             @onclick="Cart.CloseCart"></div>

        <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
            <aside class="w-screen max-w-md bg-white border-l-2 border-[#111111] flex flex-col justify-between shadow-2xl animate-in slide-in-from-right duration-300">
                
                <!-- Drawer Header -->
                <div class="flex items-center justify-between px-6 py-5 border-b border-[#111111]">
                    <div class="flex items-baseline gap-2.5">
                        <h2 id="slide-over-title" class="font-heading text-lg font-black tracking-[0.06em] text-[#111111] uppercase m-0">
                            YOUR BASKET
                        </h2>
                        @if (Cart.TotalWeightKg > 0)
                        {
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-black bg-[#FFC700] text-[#111111] uppercase tracking-wider">
                                @Cart.TotalWeightKg KG
                            </span>
                        }
                    </div>
                    <button type="button" 
                            class="p-2 -mr-2 text-[#111111] hover:text-neutral-500 transition-colors cursor-pointer bg-transparent border-0" 
                            @onclick="Cart.CloseCart" 
                            aria-label="Close cart">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Drawer Content -->
                <div class="flex-1 overflow-y-auto px-6 py-6 divide-y divide-neutral-200">
                    @if (!Cart.Items.Any())
                    {
                        <div class="h-full flex flex-col items-center justify-center text-center py-16">
                            <div class="w-16 h-16 rounded-full border-2 border-[#111111] flex items-center justify-center mb-5 text-[#111111] bg-[#FFC700]/20">
                                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                </svg>
                            </div>
                            <h3 class="font-heading text-sm font-black tracking-wider uppercase text-[#111111] mb-2">
                                YOUR BASKET IS EMPTY
                            </h3>
                            <p class="text-xs text-neutral-500 max-w-xs mb-6 uppercase tracking-wider">
                                Select dried fish delicacies from our gallery to begin your order.
                            </p>
                            <a href="/gallery" 
                               @onclick="Cart.CloseCart"
                               class="inline-block bg-[#FFC700] text-[#111111] text-xs font-heading font-black tracking-[0.1em] uppercase px-6 py-3 rounded-lg hover:bg-[#E8B400] hover:shadow-[0_4px_15px_rgba(255,199,0,0.4)] transition-all">
                                EXPLORE GALLERY
                            </a>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Cart.Items)
                        {
                            <div class="py-5 first:pt-0 last:pb-0 flex gap-4 items-start">
                                <!-- Thumbnail -->
                                <div class="w-20 h-20 flex-shrink-0 rounded-xl overflow-hidden bg-neutral-100 border border-neutral-200">
                                    <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="w-full h-full object-cover" />
                                </div>

                                <!-- Details & Controls -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <h4 class="font-heading text-xs font-black uppercase text-[#111111] tracking-wide truncate">
                                                @item.Product.Name
                                            </h4>
                                            @if (!string.IsNullOrEmpty(item.Product.LocalName))
                                            {
                                                <p class="text-[11px] text-neutral-500 uppercase tracking-wider">
                                                    (@item.Product.LocalName)
                                                </p>
                                            }
                                        </div>
                                        <button type="button" 
                                                class="text-neutral-400 hover:text-red-600 transition-colors text-xs font-bold uppercase p-1 cursor-pointer bg-transparent border-0" 
                                                @onclick="() => Cart.RemoveItem(item.Product.Id)" 
                                                title="Remove item">
                                            ✕
                                        </button>
                                    </div>

                                    <div class="text-[11px] font-medium text-neutral-600 uppercase tracking-wider mt-1">
                                        PHP @item.Product.PricePerKg.ToString("N0") / KG
                                    </div>

                                    <!-- - / + Stepper & Subtotal -->
                                    <div class="flex items-center justify-between mt-3">
                                        <div class="inline-flex items-center border border-[#111111] rounded-lg overflow-hidden bg-white">
                                            <button type="button" 
                                                    class="w-7 h-7 flex items-center justify-center font-bold text-sm text-[#111111] hover:bg-[#FFC700]/20 transition-colors cursor-pointer bg-transparent border-0" 
                                                    @onclick="() => Cart.Decrement(item.Product.Id)"
                                                    aria-label="Decrease quantity">
                                                −
                                            </button>
                                            <span class="w-12 text-center text-xs font-extrabold text-[#111111] tracking-wider select-none">
                                                @item.QuantityKg kg
                                            </span>
                                            <button type="button" 
                                                    class="w-7 h-7 flex items-center justify-center font-bold text-sm text-[#111111] hover:bg-[#FFC700]/20 transition-colors cursor-pointer bg-transparent border-0" 
                                                    @onclick="() => Cart.Increment(item.Product.Id)"
                                                    aria-label="Increase quantity">
                                                +
                                            </button>
                                        </div>

                                        <div class="font-heading text-xs font-black text-[#111111] tracking-wide">
                                            PHP @item.TotalPrice.ToString("N0")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Drawer Footer -->
                @if (Cart.Items.Any())
                {
                    <div class="px-6 py-5 border-t-2 border-[#111111] bg-neutral-50 flex flex-col gap-3.5">
                        <div class="flex justify-between items-center text-xs uppercase font-bold text-neutral-600 tracking-wider">
                            <span>TOTAL WEIGHT</span>
                            <span class="text-[#111111] font-black">@Cart.TotalWeightKg KG</span>
                        </div>
                        <div class="flex justify-between items-center text-sm uppercase font-heading font-black text-[#111111] tracking-wide pt-1 border-t border-neutral-200">
                            <span>ESTIMATED TOTAL</span>
                            <span class="text-base font-black">PHP @Cart.Subtotal.ToString("N0")</span>
                        </div>

                        <!-- Proceed to Order Button (Yellow matching homescreen) -->
                        <button type="button" 
                                class="w-full mt-2 py-3.5 px-4 bg-[#FFC700] text-[#111111] font-heading text-xs font-black tracking-[0.12em] uppercase hover:bg-[#E8B400] hover:shadow-[0_4px_15px_rgba(255,199,0,0.4)] transition-all cursor-pointer flex items-center justify-center gap-2 rounded-lg"
                                @onclick="HandleProceedToOrder">
                            <span>PROCEED TO ORDER</span>
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        </button>

                        <div class="flex justify-between items-center pt-1 text-[11px]">
                            <button type="button" 
                                    class="text-neutral-500 hover:text-red-600 transition-colors underline font-medium cursor-pointer bg-transparent border-0" 
                                    @onclick="Cart.Clear">
                                CLEAR BASKET
                            </button>
                            <span class="text-neutral-400">Order confirmed via inquiry</span>
                        </div>
                    </div>
                }
            </aside>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Cart.OnChange += OnCartChanged;
    }

    private void OnCartChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleProceedToOrder()
    {
        // Proceed to order intentionally non-functional per user request
    }

    public void Dispose()
    {
        Cart.OnChange -= OnCartChanged;
    }
}
