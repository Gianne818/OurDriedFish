@inject CartService Cart
@implements IDisposable

<div class="group flex flex-col relative transition-transform duration-300 hover:-translate-y-1">
    <div class="flex justify-start items-baseline gap-2.5 mb-3">
        <h3 class="font-heading text-xs sm:text-[13px] font-black tracking-[0.04em] text-[#111111] uppercase m-0">@Product.Name</h3>
        <span class="text-[10px] sm:text-[11px] font-medium text-neutral-600 whitespace-nowrap uppercase tracking-[0.04em]">PHP @Product.PricePerKg.ToString("N0")/KG</span>
    </div>

    <div class="relative w-full aspect-square overflow-hidden rounded-[18px] sm:rounded-[22px] bg-[#F8F7F4] mb-3">
        <img src="@Product.ImageUrl" alt="@Product.Name" class="w-full h-full object-cover rounded-[18px] sm:rounded-[22px] transition-transform duration-350 group-hover:scale-[1.03]" loading="lazy" />
        
        @if (QuantityInCart > 0)
        {
            <div class="absolute top-3 right-3 bg-[#FFC700] text-[#111111] text-[10px] font-black px-2.5 py-1 rounded-full uppercase tracking-wider shadow-md">
                @QuantityInCart KG IN BASKET
            </div>
        }
    </div>

    <!-- Weight Selector & Add to Cart Controls -->
    <div class="flex flex-col gap-2 pt-1">
        <div class="flex items-center justify-between gap-2">
            <!-- - / + Stepper -->
            <div class="inline-flex items-center border border-[#111111] rounded-lg overflow-hidden bg-white">
                <button type="button" 
                        class="w-8 h-8 flex items-center justify-center font-bold text-base text-[#111111] hover:bg-neutral-100 transition-colors cursor-pointer bg-transparent border-0 disabled:opacity-30 disabled:cursor-not-allowed" 
                        @onclick="DecrementWeight"
                        disabled="@(SelectedKg <= 1)"
                        aria-label="Decrease kg">
                    −
                </button>
                <span class="w-14 text-center text-xs font-black text-[#111111] tracking-wider select-none">
                    @SelectedKg KG
                </span>
                <button type="button" 
                        class="w-8 h-8 flex items-center justify-center font-bold text-base text-[#111111] hover:bg-neutral-100 transition-colors cursor-pointer bg-transparent border-0" 
                        @onclick="IncrementWeight"
                        aria-label="Increase kg">
                    +
                </button>
            </div>

            <!-- Price calculation for selected kg -->
            <div class="text-right">
                <div class="text-[10px] text-neutral-500 uppercase tracking-wider font-semibold">Total</div>
                <div class="font-heading text-xs sm:text-sm font-black text-[#111111]">
                    PHP @((Product.PricePerKg * SelectedKg).ToString("N0"))
                </div>
            </div>
        </div>

        <!-- Add Button with Homescreen Yellow -->
        <button type="button" 
                class="w-full py-2.5 px-3 bg-[#FFC700] text-[#111111] text-xs font-heading font-black tracking-[0.08em] uppercase hover:bg-[#E8B400] hover:shadow-[0_4px_15px_rgba(255,199,0,0.4)] transition-all cursor-pointer flex items-center justify-center gap-2 rounded-lg"
                @onclick="AddToCart">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span>ADD @SelectedKg KG TO BASKET</span>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public DriedFishItem Product { get; set; } = null!;

    private int SelectedKg { get; set; } = 1;

    private int QuantityInCart => Cart.GetQuantity(Product.Id);

    protected override void OnInitialized()
    {
        Cart.OnChange += OnCartChanged;
    }

    private void OnCartChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void IncrementWeight()
    {
        SelectedKg++;
    }

    private void DecrementWeight()
    {
        if (SelectedKg > 1)
        {
            SelectedKg--;
        }
    }

    private void AddToCart()
    {
        Cart.AddItem(Product, SelectedKg, openDrawer: true);
    }

    public void Dispose()
    {
        Cart.OnChange -= OnCartChanged;
    }
}
