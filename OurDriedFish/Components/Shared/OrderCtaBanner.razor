<section class="w-full max-w-[760px] mx-auto my-14 sm:my-16 text-center px-4">
    <span class="section-label mb-5">@Label</span>
    <h2 class="font-heading text-[clamp(24px,3.2vw,36px)] font-black leading-[1.22] tracking-[-0.02em] text-[#111111] mb-8">@Heading</h2>
    <div class="flex justify-center">
        <a href="@ButtonLink" class="btn-pill">@ButtonText</a>
    </div>
</section>

@code {
    [Parameter]
    public string Label { get; set; } = "ORDER NOW";

    [Parameter]
    public string Heading { get; set; } = "Discover how we can add a touch of natural dried deliciousness to your next meal.";

    [Parameter]
    public string ButtonText { get; set; } = "ABOUT US";

    [Parameter]
    public string ButtonLink { get; set; } = "/about";
}
