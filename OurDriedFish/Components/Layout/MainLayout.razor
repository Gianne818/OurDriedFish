@inherits LayoutComponentBase
@inject CartService Cart
@implements IDisposable

<div class="flex flex-col min-h-screen bg-white">
    <!-- Top Header strictly matching Figma reference -->
    <header class="sticky top-0 left-0 right-0 bg-white border-b border-[#111111] z-[1100]">
        <div class="site-container flex justify-between items-center h-[70px]">
            <div class="flex items-center">
                <a href="/" class="inline-flex items-center" title="Our Dried Fish Home">
                    <span class="hidden md:inline-block font-heading text-[22px] font-black text-[#111111] tracking-[-0.02em]">Our Dried Fish®</span>
                    <span class="inline-block md:hidden font-heading text-[24px] font-black text-[#111111] tracking-[-0.03em]">OB.</span>
                </a>
            </div>

            <div class="flex items-center gap-4 sm:gap-6">
                <!-- Desktop Navigation Links matching Figma mockups: GALLERY, ABOUT, CONTACT -->
                <nav class="hidden md:flex items-center gap-8" aria-label="Main Navigation">
                    <NavLink href="gallery" class="font-heading text-[11px] font-extrabold tracking-[0.1em] text-[#111111] uppercase py-1.5 hover:text-neutral-600 transition-colors">GALLERY</NavLink>
                    <NavLink href="about" class="font-heading text-[11px] font-extrabold tracking-[0.1em] text-[#111111] uppercase py-1.5 hover:text-neutral-600 transition-colors">ABOUT</NavLink>
                    <NavLink href="contact" class="font-heading text-[11px] font-extrabold tracking-[0.1em] text-[#111111] uppercase py-1.5 hover:text-neutral-600 transition-colors">CONTACT</NavLink>
                </nav>

                <!-- Basket / Cart Trigger Button -->
                <button type="button" 
                        class="relative inline-flex items-center gap-2 px-3 py-1.5 border border-[#111111] rounded-none hover:bg-[#111111] hover:text-white transition-all cursor-pointer bg-white text-[#111111] group" 
                        @onclick="Cart.ToggleCart"
                        aria-label="View shopping basket">
                    <svg class="w-4 h-4 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                    <span class="font-heading text-[11px] font-extrabold tracking-[0.1em] uppercase hidden sm:inline">
                        BASKET
                    </span>
                    <span class="inline-flex items-center justify-center text-[10px] font-black px-1.5 min-w-[20px] h-[18px] bg-[#111111] text-white group-hover:bg-white group-hover:text-[#111111] transition-colors">
                        @Cart.TotalWeightKg KG
                    </span>
                </button>

                <!-- Mobile Hamburger Toggle -->
                <button type="button" class="flex md:hidden items-center justify-center w-9 h-9 text-[#111111] bg-transparent border-0 cursor-pointer" @onclick="ToggleMobileMenu" aria-label="Toggle navigation menu">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile Nav Drawer -->
        @if (IsMobileMenuOpen)
        {
            <div class="block md:hidden bg-white border-t border-b border-neutral-200 px-6 py-4">
                <div class="flex flex-col gap-4">
                    <NavLink href="" Match="NavLinkMatch.All" class="font-heading text-sm font-extrabold tracking-[0.08em] text-[#111111] uppercase hover:text-[#FFC700] transition-colors" @onclick="CloseMobileMenu">HOME</NavLink>
                    <NavLink href="gallery" class="font-heading text-sm font-extrabold tracking-[0.08em] text-[#111111] uppercase hover:text-[#FFC700] transition-colors" @onclick="CloseMobileMenu">GALLERY</NavLink>
                    <NavLink href="about" class="font-heading text-sm font-extrabold tracking-[0.08em] text-[#111111] uppercase hover:text-[#FFC700] transition-colors" @onclick="CloseMobileMenu">ABOUT</NavLink>
                    <NavLink href="contact" class="font-heading text-sm font-extrabold tracking-[0.08em] text-[#111111] uppercase hover:text-[#FFC700] transition-colors" @onclick="CloseMobileMenu">CONTACT</NavLink>
                </div>
            </div>
        }
    </header>

    <!-- Main Content -->
    <main class="flex-1">
        @Body
    </main>

    <!-- Global Footer matching Figma -->
    <SiteFooter />

    <!-- Universal Side Cart Drawer -->
    <CartDrawer />
</div>

@code {
    private bool IsMobileMenuOpen { get; set; } = false;

    protected override void OnInitialized()
    {
        Cart.OnChange += OnCartStateChanged;
    }

    private void OnCartStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMobileMenu()
    {
        IsMobileMenuOpen = !IsMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        IsMobileMenuOpen = false;
    }

    public void Dispose()
    {
        Cart.OnChange -= OnCartStateChanged;
    }
}
